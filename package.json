{
  "name": "@jpowersdev/effect-delta",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "description": "Replicated data types and merge rules for collaborative state, built on Effect",
  "homepage": "https://github.com/jpowersdev/effect-delta",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpowersdev/effect-delta.git"
  },
  "bugs": {
    "url": "https://github.com/jpowersdev/effect-delta/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "crdt",
    "collaboration",
    "local-first"
  ],
  "keywords": [
    "typescript",
    "effect",
    "crdt",
    "collaboration",
    "local-first"
  ],
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "doctest": "vitest run --config vitest.docs.ts",
    "test-types": "tstyche",
    "circular": "node scripts/circular.mjs",
    "build": "tsc -p tsconfig.build.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "prepack": "pnpm build",
    "pack-check": "bash scripts/pack-check.sh",
    "lint": "oxlint -f unix && dprint check && dprint check --config site/dprint.json",
    "lint-fix": "oxlint --fix && dprint fmt && dprint fmt --config site/dprint.json",
    "docgen": "docgen",
    "docs:dev": "pnpm docgen && pnpm --filter ./site dev",
    "docs:build": "pnpm docgen && pnpm --filter ./site build",
    "prepare": "effect-tsgo patch"
  },
  "peerDependencies": {
    "effect": "^4.1.1"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.7",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/docgen": "4.1.1",
    "@effect/doctest": "4.1.1",
    "@effect/platform-node": "4.1.1",
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.1.1",
    "@types/node": "26.6.5",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "dprint": "0.61.1",
    "effect": "4.1.1",
    "glob": "13.0.6",
    "madge": "8.0.0",
    "oxlint": "1.87.0",
    "tstyche": "7.2.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}

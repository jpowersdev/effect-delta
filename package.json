{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel --filter \"./packages/**/*\" run codegen",
    "build": "tsc -b tsconfig.packages.json && pnpm --recursive --parallel --filter \"./packages/**/*\" run build",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "doctest": "vitest --config vitest.docs.ts",
    "check": "tsc -b tsconfig.json",
    "jsdocs": "effect-jsdocs",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "test-types": "tstyche --target '>=5.9'",
    "changeset-version": "changeset version",
    "changeset-publish": "node scripts/set-strip-internal.mjs && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.7",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/docgen": "4.0.4",
    "@effect/doctest": "4.0.4",
    "@effect/jsdocs": "workspace:^",
    "@effect/oxc": "workspace:^",
    "@effect/tsgo": "0.51.1",
    "@effect/utils": "workspace:^",
    "@effect/vitest": "4.0.4",
    "@types/node": "26.6.5",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "dprint": "0.61.1",
    "effect": "4.0.4",
    "glob": "13.0.6",
    "madge": "8.0.0",
    "oxlint": "1.87.0",
    "tstyche": "7.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
